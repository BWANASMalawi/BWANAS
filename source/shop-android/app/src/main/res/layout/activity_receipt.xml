<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/bwanas_pale">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@color/bwanas_blue">
        <Button android:id="@+id/receiptBack" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Back"/>
        <ImageView android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1" android:scaleType="fitCenter" android:src="@drawable/bwanas_logo" android:contentDescription="BWANAS"/>
    </LinearLayout>
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/receiptText" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:fontFamily="monospace" android:textColor="@color/bwanas_ink" android:textSize="16sp"/><ImageView android:id="@+id/receiptFiscalQr" android:layout_width="160dp" android:layout_height="160dp" android:layout_gravity="center" android:contentDescription="MRA validation QR code" android:visibility="gone"/></LinearLayout></ScrollView>
    <TextView android:id="@+id/receiptStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp"/>
    <Button android:id="@+id/receiptPrint" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Print receipt"/>
</LinearLayout>
